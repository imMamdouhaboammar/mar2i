# Rust build artifacts
target/
**/target/

# Tauri build output (not the source)
src-tauri/target/
core/target/

# Node / Bun
node_modules/
bun.lockb

# Frontend build output
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# Agent harness state and local symlinked skills
.fable/
.ponytail
.agents/skills/*
!.agents/skills/mar2i-ops/

# Caches and test coverage
coverage/
.cache/
*.tsbuildinfo

# Runtime database written by the app into the output folder (never in-repo)
.mar2i/

# Tauri auto-generated WiX / NSIS temp files
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# Bundled offline media binaries (downloaded/staged at build time)
src-tauri/bin/*
!src-tauri/bin/.gitkeep
!src-tauri/bin/MANIFEST.json

# Release distributions and CI temporary staging
release-dist/*
!release-dist/SHA256SUMS.txt
release-dist/macos/
release-dist/windows/
release-artifacts/
*.zip
*.tar.gz
*.tgz
