# Rust build artifacts
target/
**/target/

# Tauri build output and schemas
src-tauri/target/
core/target/
src-tauri/gen/schemas/

# Node / Bun
node_modules/
bun.lockb

# Frontend build output
dist/
dist-ssr/
*.local

# Logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor, OS and system artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
.DS_Store
._*
.Spotlight-V100
.Trashes
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Environment variables, credentials & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
*.keystore
*.jks
*.gpg
*.asc
credentials.json
service-account*.json
token.json
id_rsa*
id_ed25519*

# Agent harness state and local symlinked skills
.fable/
.ponytail
.gemini/
.system_generated/
.agent-kernel/
.no-mistakes/
.agents/skills/*
!.agents/skills/mar2i-ops/

# Caches and test coverage
coverage/
.cache/
*.tsbuildinfo

# Runtime database written by the app into the output folder (never in-repo)
.mar2i/
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Media and test raw video files (prevent committing large video files)
*.mp4
*.mov
*.mkv
*.avi
*.m4v
*.webm
*.flv
*.wmv
*.y4m
*.raw
*.m2ts
*.m4a
*.aac
*.wav

# FFmpeg 2-pass temporary passlogs and partial encodes
ffmpeg2pass*
*.log.mbtree
.mar2i-passlog-*
.mar2i-partial-*

# Tauri auto-generated WiX / NSIS temp files
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# Bundled offline media binaries (downloaded/staged at build time)
src-tauri/bin/*
!src-tauri/bin/.gitkeep
!src-tauri/bin/MANIFEST.json

# Release distributions and CI temporary staging
release-dist/*
!release-dist/SHA256SUMS.txt
release-dist/macos/
release-dist/windows/
release-artifacts/
*.zip
*.tar.gz
*.tgz
